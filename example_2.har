\":\"https:\\/\\/clarovideocdn6.clarovideo.net\\/PELICULAS\\/PLAZADEPUERTOSANTOLA\\/EXPORTACION_WEB\\/SPRITES\\/PLAZADEPUERTOSANTOLA-00h-00m-00s-00f.jpg\",\"image_trickplay\":\"https:\\/\\/clarovideocdn0.clarovideo.net\\/PELICULAS\\/PLAZADEPUERTOSANTOLA\\/EXPORTACION_WEB\\/SPRITES\\/PLAZADEPUERTOSANTOLA-TRICKPLAY.bif\",\"image_external\":null,\"duration\":\"01:43:02\",\"date\":\"20241202215634\",\"year\":\"1976\",\"preview\":\"false\",\"season_number\":null,\"episode_number\":null,\"format_types\":\"susc,briefcase,download\",\"live_enabled\":\"0\",\"live_type\":null,\"live_ref\":null,\"source_uri\":\"\",\"timeshift\":null,\"votes_average\":4,\"rating_code\":\"PG-13\",\"proveedor_name\":\"AMCO\",\"proveedor_code\":\"amco\",\"encoder_tecnology\":{\"id\":null,\"desc\":null},\"recorder_technology\":{\"id\":null,\"desc\":null},\"resource_name\":null,\"rollingcreditstime\":null,\"rollingcreditstimedb\":null,\"is_series\":false,\"channel_number\":null,\"type\":\"P\"}]},\"rtve\":{\"series\":{\"serie\":[{\"id\":\"1128361\",\"title\":\"Puerta con puerta\",\"title_episode\":\"Sálvese quien pueda\",\"title_uri\":\"Puerta-con-puerta\",\"title_original\":\"Sálvese quien pueda\",\"description\":\"En el adosado continuo a Pelayo (un conde venido a menos), se instala la familia Pérez-Gil (Ramón y Josefina), cuya fortuna proviene de la construcción y contrasta claramente con las costumbres y modales de Pelayo.\",\"description_large\":\"En el adosado continuo a Pelayo (un conde venido a menos), se instala la familia Pérez-Gil (Ramón y Josefina), cuya fortuna proviene de la construcción y contrasta claramente con las costumbres y modales de Pelayo. Beltrán (hijo de Pelayo) vende el título de marqués y su hija Fernanda, se instala de nuevo en casa al abandonar a su marido. La familia Pérez-Gil dan una fiesta de inauguración de su casa a la que invitan a sus vecinos iniciando así una relación que no es del todo bien vista por el conde.\",\"short_description\":null,\"image_large\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg?size=675x380\",\"image_medium\":\"https:\\/\\/clarovideocdn5.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WVERTICAL.jpg?size=200x300\",\"image_small\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg?size=290x163\",\"image_still\":\"https:\\/\\/clarovideocdn1.clarovideo.net\\/RTVE\\/PELICULAS\\/DG90194687-01-01-01\\/EXPORTACION_WEB\\/STILLS\\/DG90194687-01-01-01-STILL-02.jpg\",\"image_background\":\"https:\\/\\/clarovideocdn9.clarovideo.net\\/RTVE\\/SERIES\\/PUERTACONPUERTA-01-01-00\\/EXPORTACION_WEB\\/CLEAN\\/PUERTACONPUERTA-01-01-00_e-1280x720.jpg\",\"image_background_blur\":null,\"url_imagen_t1\":\"https:\\/\\/clarovideocdn8.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WVERTICAL.jpg?size=200x300\",\"url_imagen_t2\":\"https:\\/\\/clarovideocdn0.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WHORIZONTAL.jpg?size=290x163\",\"image_base_horizontal\":\"https:\\/\\/clarovideocdn4.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg\",\"image_base_vertical\":\"https:\\/\\/clarovideocdn2.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WVERTICAL.jpg\",\"image_base_square\":\"\",\"image_clean_horizontal\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WHORIZONTAL.jpg\",\"image_clean_vertical\":\"https:\\/\\/clarovideocdn5.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WVERTICAL.jpg\",\"image_clean_square\":\"\",\"image_sprites\":\"https:\\/\\/clarovideocdn3.clarovideo.net\\/RTVE\\/PELICULAS\\/DG90194687-01-01-01\\/EXPORTACION_WEB\\/SPRITES\\/DG90194687-01-01-01-SPRITEBAR.jpg\",\"image_frames\":\"https:\\/\\/clarovideocdn9.clarovideo.net\\/RTVE\\/PELICULAS\\/DG90194687-01-01-01\\/EXPORTACION_WEB\\/SPRITES\\/DG90194687-01-01-01-00h-00m-00s-00f.jpg\",\"image_trickplay\":\"https:\\/\\/clarovideocdn3.clarovideo.net\\/RTVE\\/PELICULAS\\/DG90194687-01-01-01\\/EXPORTACION_WEB\\/SPRITES\\/DG90194687-01-01-01-TRICKPLAY.bif\",\"image_external\":null,\"duration\":\"00:49:40\",\"date\":\"20230801172910\",\"year\":\"1999\",\"preview\":\"false\",\"season_number\":\"1\",\"episode_number\":\"1\",\"format_types\":\"susc,download\",\"live_enabled\":\"0\",\"live_type\":null,\"live_ref\":null,\"source_uri\":\"\",\"timeshift\":null,\"votes_average\":4,\"rating_code\":\"G\",\"proveedor_name\":\"RADIO TV ESPAÑOLA\",\"proveedor_code\":\"rtve\",\"encoder_tecnology\":{\"id\":null,\"desc\":null},\"recorder_technology\":{\"id\":null,\"desc\":null},\"resource_name\":null,\"rollingcreditstime\":null,\"rollingcreditstimedb\":null,\"is_series\":true,\"channel_number\":null,\"type\":\"P\"},{\"id\":\"1026378\",\"title\":\"MIGUEL SERVET\",\"title_episode\":\"Tiempos de apocalipsis\",\"title_uri\":\"MIGUEL-SERVET\",\"title_original\":\"Tiempos de apocalipsis\",\"description\":\"Corre el año 1532 en Ratisbona, Alemania. El nuncio de Su Santidad se escandaliza ante la aparición del libro De Trinitatis Erroribus. Su autor es alguien que se dice nacido en Aragón, llamado Miguel Servet\",\"description_large\":\"Corre el año 1532 en Ratisbona, Alemania. El nuncio de Su Santidad se escandaliza ante la aparición del libro De Trinitatis Erroribus. Su autor es alguien que se dice nacido en Aragón, llamado Miguel Servet. La Inquisición española inicia su búsqueda y localiza a mosén Juan Servet, un joven fraile asustado, hermano del autor. El interrogatorio de Juan revela la vida de los Servet en la villa de Sigena, la educación de Miguel en el monasterio y sus posteriores estudios en Toulouse.\",\"short_description\":null,\"image_large\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P8718690\\/EXPORTACION_WEB\\/SS\\/P8718690WHORIZONTAL.jpg