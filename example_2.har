,\"year\":\"2016\",\"preview\":\"true\",\"season_number\":null,\"episode_number\":null,\"format_types\":\"ppe,download\",\"live_enabled\":\"0\",\"live_type\":null,\"live_ref\":null,\"source_uri\":\"\",\"timeshift\":null,\"votes_average\":4,\"rating_code\":\"PG\",\"proveedor_name\":\"AMCO\",\"proveedor_code\":\"amco\",\"encoder_tecnology\":{\"id\":null,\"desc\":null},\"recorder_technology\":{\"id\":null,\"desc\":null},\"resource_name\":null,\"rollingcreditstime\":null,\"rollingcreditstimedb\":null,\"is_series\":false,\"channel_number\":null,\"type\":\"P\"}]},\"rtve\":{\"series\":{\"serie\":[{\"id\":\"1128361\",\"title\":\"Puerta con puerta\",\"title_episode\":\"Sálvese quien pueda\",\"title_uri\":\"Puerta-con-puerta\",\"title_original\":\"Sálvese quien pueda\",\"description\":\"En el adosado continuo a Pelayo (un conde venido a menos), se instala la familia Pérez-Gil (Ramón y Josefina), cuya fortuna proviene de la construcción y contrasta claramente con las costumbres y modales de Pelayo.\",\"description_large\":\"En el adosado continuo a Pelayo (un conde venido a menos), se instala la familia Pérez-Gil (Ramón y Josefina), cuya fortuna proviene de la construcción y contrasta claramente con las costumbres y modales de Pelayo. Beltrán (hijo de Pelayo) vende el título de marqués y su hija Fernanda, se instala de nuevo en casa al abandonar a su marido. La familia Pérez-Gil dan una fiesta de inauguración de su casa a la que invitan a sus vecinos iniciando así una relación que no es del todo bien vista por el conde.\",\"short_description\":null,\"image_large\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg?size=675x380\",\"image_medium\":\"https:\\/\\/clarovideocdn5.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WVERTICAL.jpg?size=200x300\",\"image_small\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg