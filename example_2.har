_WEB\\/SPRITES\\/700EUROSDIARIOSECRETODEUNACALLGIRLCAP1HDPA1-01-01-01-00h-00m-00s-00f.jpg\",\"image_trickplay\":\"https:\\/\\/clarovideocdn6.clarovideo.net\\/ATRESPLAYER\\/PELICULAS\\/700EUROSDIARIOSECRETODEUNACALLGIRLCAP1HDPA1-01-01-01\\/EXPORTACION_WEB\\/SPRITES\\/700EUROSDIARIOSECRETODEUNACALLGIRLCAP1HDPA1-01-01-01-TRICKPLAY.bif\",\"image_external\":null,\"duration\":\"01:36:51\",\"date\":\"20260430150216\",\"year\":\"2009\",\"preview\":\"false\",\"season_number\":\"1\",\"episode_number\":\"1\",\"format_types\":\"susc\",\"live_enabled\":\"0\",\"live_type\":null,\"live_ref\":null,\"source_uri\":\"\",\"timeshift\":null,\"votes_average\":4,\"rating_code\":\"PG\",\"proveedor_name\":\"ATRESPLAYER\",\"proveedor_code\":\"atresplayer\",\"encoder_tecnology\":{\"id\":null,\"desc\":null},\"recorder_technology\":{\"id\":null,\"desc\":null},\"resource_name\":null,\"rollingcreditstime\":null,\"rollingcreditstimedb\":null,\"is_series\":true,\"channel_number\":null,\"type\":\"P\"},{\"id\":\"906719\",\"title\":\"90-60-90, Diario Secreto De Una Adolescente\",\"title_episode\":\"90-60-90, Diario Secreto De Una Adolescente\",\"title_uri\":\"90-60-90-Diario-Secreto-De-Una-Adolescente\",\"title_original\":\"90-60-90, Diario Secreto De Una Adolescente\",\"description\":\"Mel y Africa van a grabar un videoclip. Aunque la madre de Mel no está de acuerdo, las chicas acuden a la grabación. Lo que no saben es que allí conocerán a Bruno, Mel no sabe aún de quién se trata.\",\"description_large\":\"Narra la vida de Mel, una adolescente huérfana de padre y, por un accidente, también de madre. Junto a su amiga África, les saldrá la oportunidad de ser modelos para la agencia I Deal, dirigida por Chantal y su esposo Abe. Adentrándose en los entresijos del mundo de la moda, conocerán a Bruno, que trabaja de fotógrafo en la agencia, divorciado de Mary Carmen y con una hija, Luz. Entre Mel y Bruno surgirá una relación sentimental fuera de lo común, ya que éste le dobla la edad a la joven, ella es una adolescente de 16 años y él un hombre de 41.\",\"short_description\":null,\"image_large\":\"https:\\/\\/clarovideocdn8.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/SS\\/11902WHORIZONTAL.jpg?size=675x380\",\"image_medium\":\"https:\\/\\/clarovideocdn6.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/SS\\/11902WVERTICAL.jpg?size=200x300\",\"image_small\":\"https:\\/\\/clarovideocdn8.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/SS\\/11902WHORIZONTAL.jpg?size=290x163\",\"image_still\":\"https:\\/\\/clarovideocdn6.clarovideo.net\\/ATRESPLAYER\\/PELICULAS\\/906090DIARIOSECRETODEUNAADOLESCENTECAP1HDPA1-01-01-01\\/EXPORTACION_WEB\\/STILLS\\/906090DIARIOSECRETODEUNAADOLESCENTECAP1HDPA1-01-01-01-STILL-02.jpg\",\"image_background\":\"https:\\/\\/clarovideocdn6.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/906090DIARIOSECRETODEUNAADOLESCENTE-01-01-00\\/EXPORTACION_WEB\\/CLEAN\\/906090DIARIOSECRETODEUNAADOLESCENTE-01-01-00_e-1280x720.jpg\",\"image_background_blur\":null,\"url_imagen_t1\":\"https:\\/\\/clarovideocdn9.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/CLEAN\\/11902WVERTICAL.jpg?size=200x300\",\"url_imagen_t2\":\"https:\\/\\/clarovideocdn1.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/CLEAN\\/11902WHORIZONTAL.jpg?size=290x163\",\"image_base_horizontal\":\"https:\\/\\/clarovideocdn5.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/SS\\/11902WHORIZONTAL.jpg\",\"image_base_vertical\":\"https:\\/\\/clarovideocdn3.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/SS\\/11902WVERTICAL.jpg\",\"image_base_square\":\"\",\"image_clean_horizontal\":\"https:\\/\\/clarovideocdn8.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/CLEAN\\/11902WHORIZONTAL.jpg\",\"image_clean_vertical\":\"https:\\/\\/clarovideocdn6.clarovideo.net\\/ATRESPLAYER\\/SERIES\\/11902\\/EXPORTACION_WEB\\/CLEAN\\/11902WVERTICAL.jpg\",\"image_clean_square\":\"\",\"image_sp