ovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg?size=675x380\",\"image_medium\":\"https:\\/\\/clarovideocdn5.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WVERTICAL.jpg?size=200x300\",\"image_small\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg?size=290x163\",\"image_still\":\"https:\\/\\/clarovideocdn1.clarovideo.net\\/RTVE\\/PELICULAS\\/DG90194687-01-01-01\\/EXPORTACION_WEB\\/STILLS\\/DG90194687-01-01-01-STILL-02.jpg\",\"image_background\":\"https:\\/\\/clarovideocdn9.clarovideo.net\\/RTVE\\/SERIES\\/PUERTACONPUERTA-01-01-00\\/EXPORTACION_WEB\\/CLEAN\\/PUERTACONPUERTA-01-01-00_e-1280x720.jpg\",\"image_background_blur\":null,\"url_imagen_t1\":\"https:\\/\\/clarovideocdn8.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WVERTICAL.jpg?size=200x300\",\"url_imagen_t2\":\"https:\\/\\/clarovideocdn0.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WHORIZONTAL.jpg?size=290x163\",\"image_base_horizontal\":\"https:\\/\\/clarovideocdn4.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WHORIZONTAL.jpg\",\"image_base_vertical\":\"https:\\/\\/clarovideocdn2.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/SS\\/P2271109WVERTICAL.jpg\",\"image_base_square\":\"\",\"image_clean_horizontal\":\"https:\\/\\/clarovideocdn7.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WHORIZONTAL.jpg\",\"image_clean_vertical\":\"https:\\/\\/clarovideocdn5.clarovideo.net\\/RTVE\\/SERIES\\/P2271109\\/EXPORTACION_WEB\\/CLEAN\\/P2271109WVERTICAL.jpg\",\"image_clean_square\":\"\",\"image_sprites\":\"https:\\/\\/clarovideocdn3.clarovideo.net\\/RTVE\\/PELICULAS\\/DG90194687-01-01-01\\/EXPORTACION_WEB\\/SPRITES\\/DG90194687-01-01-01-SPRITEBAR.jpg\",\"image_frames\":\"https:\\/\\/clarovideocdn9.clarovideo.net\\/RTVE\\/PELICULAS\\/